Grammar

    0 $accept: compilationUnit $end

    1 compilationUnit: packageDeclaration topLevelDeclarations
    2                | topLevelDeclarations
    3                | moduleDeclaration

    4 packageDeclaration: annotations_opt PACKAGE qualifiedName SEMI

    5 topLevelDeclarations: %empty
    6                     | topLevelDeclarations topLevelDeclaration

    7 topLevelDeclaration: importDeclaration
    8                    | typeDeclaration

    9 importDeclaration: IMPORT STATIC qualifiedName SEMI
   10                  | IMPORT STATIC qualifiedName DOT MUL SEMI
   11                  | IMPORT qualifiedName SEMI
   12                  | IMPORT qualifiedName DOT MUL SEMI

   13 typeDeclaration: modifiers_opt classDeclaration
   14                | modifiers_opt enumDeclaration
   15                | modifiers_opt interfaceDeclaration
   16                | modifiers_opt annotationTypeDeclaration
   17                | modifiers_opt recordDeclaration

   18 moduleDeclaration: annotations_opt open_opt MODULE qualifiedName LBRACE moduleDirectives RBRACE

   19 open_opt: %empty
   20         | OPEN

   21 moduleDirectives: %empty
   22                 | moduleDirectives moduleDirective

   23 moduleDirective: REQUIRES requiresModifiers_opt qualifiedName SEMI
   24                | EXPORTS qualifiedName exportsTo_opt SEMI
   25                | OPENS qualifiedName exportsTo_opt SEMI
   26                | USES qualifiedName SEMI
   27                | PROVIDES qualifiedName WITH qualifiedNameList SEMI

   28 requiresModifiers_opt: %empty
   29                      | requiresModifiers_opt TRANSITIVE
   30                      | requiresModifiers_opt STATIC

   31 exportsTo_opt: %empty
   32              | TO qualifiedNameList

   33 modifiers_opt: %empty
   34              | modifiers_opt modifier

   35 modifier: annotation
   36         | PUBLIC
   37         | PROTECTED
   38         | PRIVATE
   39         | STATIC
   40         | ABSTRACT
   41         | FINAL
   42         | STRICTFP
   43         | SEALED
   44         | NON_SEALED
   45         | NATIVE
   46         | SYNCHRONIZED
   47         | TRANSIENT
   48         | VOLATILE
   49         | DEFAULT

   50 variableModifiers_opt: %empty
   51                      | variableModifiers

   52 variableModifiers: variableModifier
   53                  | variableModifiers variableModifier

   54 variableModifier: FINAL
   55                 | annotation

   56 annotations_opt: %empty
   57                | annotations_opt annotation

   58 annotation: AT qualifiedName
   59           | AT qualifiedName LPAREN elementValuePairs_opt RPAREN
   60           | AT qualifiedName LPAREN elementValue RPAREN

   61 elementValuePairs_opt: %empty
   62                      | elementValuePairs

   63 elementValuePairs: elementValuePair
   64                  | elementValuePairs COMMA elementValuePair

   65 elementValuePair: identifier ASSIGN elementValue

   66 elementValue: expression
   67             | annotation
   68             | elementValueArrayInitializer

   69 elementValueArrayInitializer: LBRACE elementValues_opt RBRACE

   70 elementValues_opt: %empty
   71                  | elementValueList
   72                  | elementValueList COMMA

   73 elementValueList: elementValue
   74                 | elementValueList COMMA elementValue

   75 comma_opt: %empty
   76          | COMMA

   77 classDeclaration: CLASS identifier typeParameters_opt extendsClause_opt implementsClause_opt permitsClause_opt classBody

   78 extendsClause_opt: %empty
   79                  | EXTENDS typeType

   80 implementsClause_opt: %empty
   81                     | IMPLEMENTS typeList

   82 permitsClause_opt: %empty
   83                  | PERMITS typeList

   84 classBody: LBRACE classBodyDeclarations RBRACE

   85 classBodyDeclarations: %empty
   86                      | classBodyDeclarations classBodyDeclaration

   87 classBodyDeclaration: STATIC block
   88                     | block
   89                     | modifiers_opt memberDeclaration

   90 memberDeclaration: methodDeclaration
   91                  | genericMethodDeclaration
   92                  | fieldDeclaration
   93                  | constructorDeclaration
   94                  | genericConstructorDeclaration
   95                  | compactConstructorDeclaration
   96                  | classDeclaration
   97                  | enumDeclaration
   98                  | interfaceDeclaration
   99                  | annotationTypeDeclaration
  100                  | recordDeclaration

  101 recordDeclaration: RECORD identifier typeParameters_opt recordHeader implementsClause_opt recordBody

  102 recordHeader: LPAREN recordComponentList_opt RPAREN

  103 recordComponentList_opt: %empty
  104                        | recordComponentList

  105 recordComponentList: recordComponent
  106                    | recordComponentList COMMA recordComponent

  107 recordComponent: variableModifiers_opt typeType identifier
  108                | variableModifiers_opt typeType ELLIPSIS identifier

  109 recordBody: LBRACE recordBodyDeclarations RBRACE

  110 recordBodyDeclarations: %empty
  111                       | recordBodyDeclarations recordBodyDeclaration

  112 recordBodyDeclaration: classBodyDeclaration
  113                      | compactConstructorDeclaration

  114 compactConstructorDeclaration: identifier block

  115 interfaceDeclaration: INTERFACE identifier typeParameters_opt interfaceExtends_opt permitsClause_opt interfaceBody

  116 interfaceExtends_opt: %empty
  117                     | EXTENDS typeList

  118 interfaceBody: LBRACE interfaceBodyDeclarations RBRACE

  119 interfaceBodyDeclarations: %empty
  120                          | interfaceBodyDeclarations interfaceBodyDeclaration

  121 interfaceBodyDeclaration: modifiers_opt interfaceMemberDeclaration

  122 interfaceMemberDeclaration: constDeclaration
  123                           | interfaceMethodDeclaration
  124                           | genericInterfaceMethodDeclaration
  125                           | classDeclaration
  126                           | enumDeclaration
