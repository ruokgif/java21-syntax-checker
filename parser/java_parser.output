  133 constantDeclarator: identifier dims_opt ASSIGN variableInitializer

  134 interfaceMethodDeclaration: typeType identifier formalParameters dims_opt throwsClause_opt methodBody
  135                           | VOID identifier formalParameters dims_opt throwsClause_opt methodBody

  136 genericInterfaceMethodDeclaration: typeParameters typeType identifier formalParameters dims_opt throwsClause_opt methodBody
  137                                  | typeParameters VOID identifier formalParameters dims_opt throwsClause_opt methodBody

  138 enumDeclaration: ENUM identifier implementsClause_opt LBRACE enumConstants_opt comma_opt enumBodyDeclarations_opt RBRACE

  139 enumConstants_opt: %empty
  140                  | enumConstantList

  141 enumConstantList: enumConstant
  142                 | enumConstantList COMMA enumConstant

  143 enumConstant: annotations_opt identifier arguments_opt classBody_opt

  144 classBody_opt: %empty
